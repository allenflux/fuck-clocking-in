# Slack 应用 OAuth & Permissions -> User OAuth Token，必须是 xoxp- 用户令牌。
SLACK_USER_TOKEN=

# 先运行 --list-dms / --inspect 获取下面的 ID。
SLACK_ATTENDANCE_CHANNEL_ID=
SLACK_ATTENDANCE_SENDER_ID=
SLACK_EXPECTED_USER_ID=

# 填机器人消息里 HH:MM 的时区，而不是 VPS 的系统时区。
SLACK_TIMEZONE=Asia/Shanghai
POLL_INTERVAL_SECONDS=60
HTTP_TIMEOUT_SECONDS=15
ATTENDANCE_STATE_PATH=data/state.sqlite3
